        <mass value="0.026220563544168" />
        <inertia ixx="3.99300927072797E-06"
                 ixy="8.05472791554887E-07"
                 ixz="-1.41386311174174E-09"
                 iyy="5.36309622677164E-06"
                 iyz="7.82422880681819E-10"
                 izz="3.79010403400001E-06" />
      </inertial>
      <visual>
        <origin xyz="0 0 0"
