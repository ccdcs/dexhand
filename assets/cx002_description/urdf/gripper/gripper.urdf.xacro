        <mass value="0.0184483252494793" />
        <inertia ixx="2.2627863545962E-06"
                 ixy="1.39077727093282E-06"
                 ixz="-5.44225031103077E-09"
                 iyy="2.12159040565448E-06"
                 iyz="4.45445433268214E-09"
                 izz="3.02402802408448E-06" />
      </inertial>
      <visual>
        <origin xyz="0 0 0"
                rpy="0 0 0" />
        <geometry>
          <mesh filename="package://cx002_description/meshes/gripper/right_support_finger.STL" />
        </geometry>
        <material name="">
          <color rgba="0.866666666666667 0.866666666666667 0.890196078431372 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0"
