<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro name="gripper"
               params="prefix">
    <link name="${prefix}gripper_base">
      <inertial>
        <origin xyz="0.0462781999245805 0.00114671171262361 -0.0016100126939254"
                rpy="0 0 0" />
        <mass value="0.952152443135814" />
        <inertia ixx="0.000414436104373698"
                 ixy="1.07361896761865E-06"
                 ixz="-1.71645770864691E-06"
                 iyy="0.00031421634442519"
                 iyz="6.86060394459976E-07"
                 izz="0.000512365606816346" />
      </inertial>
      <visual>
        <origin xyz="0 0 0"
                rpy="0 0 0" />
        <geometry>
          <mesh filename="package://cx002_description/meshes/gripper/gripper_base.STL" />
        </geometry>
        <material name="">
          <color rgba="0.866666666666667 0.866666666666667 0.890196078431372 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0"
                rpy="0 0 0" />
        <geometry>
          <mesh filename="package://cx002_description/meshes/gripper/collision/gripper_base.STL" />
        </geometry>
      </collision>
    </link>
    <link name="${prefix}left_finger">
      <inertial>
        <origin xyz="0.0136277996037277 0.0258258666940151 -4.20136743402248E-06"
                rpy="0 0 0" />
        <mass value="0.0522377269720752" />
        <inertia ixx="1.96815469886496E-05"
                 ixy="-1.34835303241136E-05"
                 ixz="1.06418129160967E-10"
                 iyy="1.68544651967478E-05"
                 iyz="7.46986432930518E-10"
                 izz="3.45456689219043E-05" />
      </inertial>
      <visual>
        <origin xyz="0 0 0"
                rpy="0 0 0" />
        <geometry>
          <mesh filename="package://cx002_description/meshes/gripper/left_finger.STL" />
        </geometry>
        <material name="">
          <color rgba="0.866666666666667 0.866666666666667 0.890196078431372 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0"
                rpy="0 0 0" />
        <geometry>
          <mesh filename="package://cx002_description/meshes/gripper/collision/left_finger.STL" />
        </geometry>
      </collision>
    </link>
    <link name="${prefix}end_effector" />
    <joint name="${prefix}end_effector_joint"
           type="fixed">
      <origin xyz="0.155 0.0 0.0"
              rpy="0 0 0" />
      <parent link="${prefix}gripper_base" />
      <child link="${prefix}end_effector" />
      <axis xyz="0 0 1" />
    </joint>
    <link name="${prefix}motor_link" />
    <joint name="${prefix}gripper_joint"
           type="revolute">
      <origin xyz="0.0 0.0 0.0"
              rpy="0 0 0" />
      <parent link="${prefix}gripper_base" />
      <child link="${prefix}motor_link" />
      <axis xyz="0 0 1" />
      <limit lower="-0.001"
             upper="25.133"
             effort="10"
             velocity="10" />
    </joint>
    <link name="${prefix}suction_motor_link" />
    <joint name="${prefix}suction_motor_joint"
           type="continuous">
      <parent link="${prefix}gripper_base" />
      <child link="${prefix}suction_motor_link" />
      <origin xyz="0 0 0.05"
              rpy="0 0 0" />
      <axis xyz="0 0 1" />
    </joint>
    <joint name="${prefix}left_joint"
           type="revolute">
      <origin xyz="0.0817 0.0325 0"
              rpy="0 0 0" />
      <parent link="${prefix}gripper_base" />
      <child link="${prefix}left_finger" />
      <axis xyz="0 0 -1" />
      <limit lower="-0.001"
