        <mass value="0.0264604333631762" />
        <inertia ixx="3.59147955478828E-06"
                 ixy="-4.86127839894415E-07"
                 ixz="1.18141683608297E-10"
                 iyy="4.39601774702969E-06"
                 iyz="1.04627059446172E-10"
                 izz="2.80008769953329E-06" />
      </inertial>
      <visual>
        <origin xyz="0 0 0"
                rpy="0 0 0" />
        <geometry>
          <mesh filename="package://cx002_description/meshes/gripper/right_finger_tip.STL" />
        </geometry>
        <material name="">
          <color rgba="0.384313725490196 0.384313725490196 0.384313725490196 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0"
                rpy="0 0 0" />
        <geometry>
          <mesh filename="package://cx002_description/meshes/gripper/collision/right_finger_tip.STL" />
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}right_passive_joint"
