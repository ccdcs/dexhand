             effort="10"
             velocity="10" />
      <mimic joint="${prefix}left_joint"
             multiplier="1"
             offset="0" />
    </joint>
    <link name="${prefix}left_support_link">
      <inertial>
        <origin xyz="0.0306867487162492 0.0334560135651763 -5.09441124930597E-05"
                rpy="0 0 0" />
        <mass value="0.0184483252494793" />
        <inertia ixx="2.2627863545962E-06"
                 ixy="-1.39077727093282E-06"
                 ixz="5.44225031102969E-09"
                 iyy="2.12159040565448E-06"
                 iyz="4.45445433268261E-09"
                 izz="3.02402802408449E-06" />
      </inertial>
      <visual>
        <origin xyz="0 0 0"
