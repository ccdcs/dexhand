                 ixz="-1.06418129139127E-10"
                 iyy="1.68544651978331E-05"
                 iyz="7.46986432888273E-10"
                 izz="3.45456689219047E-05" />
      </inertial>
      <visual>
        <origin xyz="0 0 0"
